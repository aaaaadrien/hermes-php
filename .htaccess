# Hermes (PHP) — configuration Apache (production)
# Placez le contenu du projet dans le DocumentRoot et activez mod_rewrite.

Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Refus de l'accès direct : données, code et fichiers cachés
    # (avant la règle qui sert les fichiers existants).
    RewriteRule ^(data|vendor|tests|ressources)(/|$) - [F,L]
    RewriteRule ^\. - [F,L]

    # Ne pas réécrire les fichiers/dossiers existants (assets de la SPA...).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste passe par le front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Sécurité : interdire tout accès HTTP direct aux répertoires de données et de code.
<FilesMatch "\.(db|sqlite|conf|conf\.example|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Pas de cache pour l'API (SSE / JSON).
    <FilesMatch "^index\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Limites adaptées aux gros fichiers joints : voir .user.ini
# (les directives php_value de .htaccess cassent le site sous php-fpm).
